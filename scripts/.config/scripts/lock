#!/bin/sh

# Картинку готовит wallpaper-rotation: текущие обои, отмасштабированные под экран.
lock_image="${XDG_CACHE_HOME:-${HOME}/.cache}/wallpaper-rotation/lock.png"

# Палитра нейтральная (серая шкала), чтобы не спорить со случайными обоями.
# Цветом отмечено только состояние ошибки — это сигнал, а не оформление.

# Заливка круга тёмная, а не пустая: она и служит подложкой, без которой
# время лежит прямо на фотографии. Она же даёт кольцу контраст с внутренней
# стороны, поэтому светлое кольцо видно и на светлых обоях.
# Альфа строго ff: при меньшей picom показывает сквозь круг реальный рабочий
# стол с окнами, а не картинку блокировки.
INSIDE='#1a1a1aff'
INSIDE_VER='#242424ff'
INSIDE_WRONG='#2b2b2bff'

TRANSPARENT='#00000000'
RING='#e8e8e8ff'
RING_VER='#9e9e9eff'
RING_WRONG='#e05252ff'

TEXT='#ffffffff'
TEXT_DIM='#c4c4c4ff'
TEXT_WRONG='#ff9a9aff'

SEPARATOR='#8a8a8aff'
KEY_HL='#ffffffff'
BS_HL='#8a8a8aff'

if [ -r "${lock_image}" ]; then
  background="--image=${lock_image}"
else
  background="--color=00564d"
fi

# --nofork обязателен: xss-lock считает блокировку снятой, как только процесс вышел.
# Часы и цветной индикатор умеет только i3lock-color; на обычном i3lock эти
# флаги приводят к «unrecognized option» и экран не блокируется вовсе.
# Проба именно по флагу: i3lock-color не пишет «color» ни в --version, ни в --help,
# а разбор аргументов идёт до подключения к X, поэтому --version тут безопасен.
if ! i3lock --clock --version >/dev/null 2>&1; then
  exec i3lock --nofork --ignore-empty-password --show-failed-attempts "${background}"
fi

exec i3lock \
  --nofork                     \
  --ignore-empty-password      \
  --show-failed-attempts       \
  "${background}"              \
  --fill                       \
\
  --insidever-color=$INSIDE_VER     \
  --ringver-color=$RING_VER         \
\
  --insidewrong-color=$INSIDE_WRONG \
  --ringwrong-color=$RING_WRONG     \
\
  --inside-color=$INSIDE            \
  --ring-color=$RING                \
  --line-color=$TRANSPARENT         \
  --separator-color=$SEPARATOR      \
\
  --verif-color=$TEXT               \
  --wrong-color=$TEXT_WRONG         \
  --time-color=$TEXT                \
  --date-color=$TEXT_DIM            \
  --layout-color=$TEXT_DIM          \
  --keyhl-color=$KEY_HL             \
  --bshl-color=$BS_HL               \
\
  --radius 120                      \
  --ring-width 12                   \
  --time-size 34                    \
  --date-size 18                    \
  --layout-size 16                  \
\
  --screen 1                        \
  --clock                           \
  --indicator                       \
  --time-str="%H:%M:%S"             \
  --date-str="%A, %Y-%m-%d"         \
  --keylayout 1
