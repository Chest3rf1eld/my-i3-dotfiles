#!/usr/bin/env bash
set -u

script_path="$(realpath "$0" 2>/dev/null || printf '%s' "$0")"
script_dir="$(cd "$(dirname "${script_path}")" && pwd)"
repo_root="$(cd "${script_dir}/../../.." && pwd)"
repo_wallpaper_dir="${repo_root}/wallpapers/.local/share/wallpapers"
wallpaper_dir="${WALLPAPER_DIR:-${repo_wallpaper_dir}}"
interval="${1:-900}"
lock_file="${XDG_RUNTIME_DIR:-/tmp}/wallpaper-rotation-${UID}.lock"
cache_dir="${XDG_CACHE_HOME:-${HOME}/.cache}/wallpaper-rotation"
set_wallpaper_script="${script_dir}/set-wallpaper"
parent_pid="${PPID}"

exec 9>"${lock_file}"
flock -n 9 || exit 0

mkdir -p "${cache_dir}"

session_sleep() {
  local remaining="$1"

  while (( remaining > 0 )); do
    kill -0 "${parent_pid}" 2>/dev/null || exit 0

    if (( remaining > 1 )); then
      sleep 1 9<&-
      ((remaining--))
    else
      sleep "${remaining}" 9<&-
      remaining=0
    fi
  done
}

while true; do
  mapfile -d '' wallpapers < <(
    find "${wallpaper_dir}" -type f \
      \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.bmp' \) \
      -print0 2>/dev/null
  )

  if ((${#wallpapers[@]} > 0)); then
    wallpaper="${wallpapers[RANDOM % ${#wallpapers[@]}]}"
    if ! "${set_wallpaper_script}" "${wallpaper}"; then
      echo "wallpaper-rotation: не удалось применить ${wallpaper}" >&2
    fi
  else
    echo "wallpaper-rotation: no images in ${wallpaper_dir}" >&2
  fi

  # 9<&- — иначе sleep наследует lock-fd и держит блокировку после смерти скрипта
  session_sleep "${interval}"
done
