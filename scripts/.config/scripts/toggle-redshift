#!/usr/bin/env bash

set -euo pipefail

# Reading mode for X11.
#
# Prefer gammastep: it applies a proper color-temperature transform, closer to
# Night Light / Night Shift implementations than a hand-tuned xrandr RGB ratio.
# Brightness is intentionally left unchanged.

state_dir="${XDG_RUNTIME_DIR:-/tmp}"
state_file="${state_dir}/i3-reading-mode-${UID}"

# Tunables. Override from environment if needed, e.g.:
#   READING_TEMP=4300 ~/.config/scripts/toggle-redshift
# 4300K is warm but not excessively yellow.
reading_temp="${READING_TEMP:-4300}"
fallback_gamma="${READING_GAMMA:-1:0.85:0.69}"

notify() {
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send -u low -t 1200 "Reading mode" "$1" >/dev/null 2>&1 || true
}

connected_outputs() {
    xrandr --query | awk '$2 == "connected" { print $1 }'
}

reset_xrandr() {
    mapfile -t outputs < <(connected_outputs)
    for output in "${outputs[@]}"; do
        xrandr --output "$output" --gamma 1:1:1
    done
}

apply_xrandr() {
    mapfile -t outputs < <(connected_outputs)
    for output in "${outputs[@]}"; do
        xrandr --output "$output" --gamma "$fallback_gamma"
    done
}

turn_off() {
    rm -f -- "$state_file"

    if command -v gammastep >/dev/null 2>&1; then
        gammastep -x >/dev/null 2>&1 || true
    fi

    if command -v redshift >/dev/null 2>&1; then
        redshift -x >/dev/null 2>&1 || true
    fi

    if command -v sct >/dev/null 2>&1; then
        sct 6500 >/dev/null 2>&1 || true
    fi

    reset_xrandr
    notify "off"
}

turn_on() {
    touch "$state_file"

    if command -v gammastep >/dev/null 2>&1; then
        gammastep -P -O "$reading_temp" >/dev/null 2>&1 || apply_xrandr
    elif command -v redshift >/dev/null 2>&1; then
        redshift -P -O "$reading_temp" >/dev/null 2>&1 || apply_xrandr
    elif command -v sct >/dev/null 2>&1; then
        sct "$reading_temp" >/dev/null 2>&1 || apply_xrandr
    else
        apply_xrandr
    fi

    notify "on: ${reading_temp}K"
}

case "${1:---toggle}" in
    --on)
        turn_on
        ;;
    --off)
        turn_off
        ;;
    --toggle)
        if [[ -e "$state_file" ]]; then
            turn_off
        else
            turn_on
        fi
        ;;
    *)
        printf 'Usage: %s [--toggle|--on|--off]\n' "$0" >&2
        exit 1
        ;;
esac
