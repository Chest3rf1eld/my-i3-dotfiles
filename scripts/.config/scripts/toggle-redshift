#!/usr/bin/env bash

set -euo pipefail

state_dir="${XDG_RUNTIME_DIR:-/tmp}"
state_file="${state_dir}/i3-night-light-${UID}"

mapfile -t outputs < <(xrandr --query | awk '$2 == "connected" { print $1 }')

if [[ -e "$state_file" ]]; then
    gamma="1:1:1"
    rm -f -- "$state_file"
else
    gamma="1:0.93:0.85"
    touch "$state_file"
fi

for output in "${outputs[@]}"; do
    xrandr --output "$output" --gamma "$gamma"
done
